<Project Sdk="Microsoft.NET.Sdk">

  <!-- dotnet new şablon paketi: dotnet new install FormWind.Templates; dotnet new formwind-app -n MyApp -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>FormWind.Templates</PackageId>
    <Title>FormWind templates</Title>
    <Description>dotnet new templates for FormWind: a WinForms app with sign-in, list-detail and settings screens styled with Tailwind-style classes.</Description>
    <PackageTags>dotnet-new;templates;winforms;tailwind;formwind</PackageTags>
    <IsPackable>true</IsPackable>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Şablon paketinde lib/ klasörü olmaz (NU5128). -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- content\formwind-app\… paket içinde de content\formwind-app\… olur (NuGet klasör yolunu ekler). -->
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" PackagePath="content" />
  </ItemGroup>

</Project>
