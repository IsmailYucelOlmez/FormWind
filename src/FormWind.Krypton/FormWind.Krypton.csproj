<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FormWind.Krypton</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>FormWind.Krypton</PackageId>
    <Description>Applies FormWind classes to the state palettes of Krypton Toolkit controls.</Description>
    <PackageTags>winforms;tailwind;krypton;theme</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krypton.Toolkit" Version="105.26.7.201" />
    <ProjectReference Include="..\FormWind\FormWind.csproj" />
    <!-- NuGet okuyucuları için İngilizce README, paket içinde README.md adıyla. -->
    <None Include="..\..\README.en.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

</Project>
